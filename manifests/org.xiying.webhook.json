{
  "formatVersion": 1,
  "id": "org.xiying.webhook",
  "name": "Webhook 通知器",
  "description": "将 汐影核心生成的统一通知内容发送到 HTTP(S) Webhook。",
  "version": "__VERSION__",
  "apiVersion": 1,
  "runtime": {"kind": "process", "entrypoint": "__ENTRYPOINT__"},
  "type": "notification",
  "category": "NOTIFICATION",
  "capabilities": ["notification.send"],
  "configFields": [{
    "key": "payloadFormat",
    "label": "Payload 格式",
    "type": "select",
    "required": true,
    "defaultValue": "LUX",
    "options": [
      {"value": "LUX", "label": "汐影原生"},
      {"value": "EMBY", "label": "Emby 风格"}
    ]
  }],
  "permissions": {"network": ["notification-target"], "filesystem": []},
  "files": []
}
